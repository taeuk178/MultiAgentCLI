{
  "_doc": "Default redaction rules. 사용자가 ~/.claude/imprint/redact-rules.json을 만들면 그 파일이 우선한다. 정규식은 Python re 모듈 문법.",
  "rules": [
    {
      "name": "anthropic_api_key",
      "pattern": "sk-ant-[A-Za-z0-9_-]{20,}",
      "replacement": "sk-ant-[REDACTED]"
    },
    {
      "name": "openai_api_key",
      "pattern": "sk-(?!ant-)[A-Za-z0-9]{20,}",
      "replacement": "sk-[REDACTED]"
    },
    {
      "name": "github_pat",
      "pattern": "gh[pousr]_[A-Za-z0-9]{20,}",
      "replacement": "gh*_[REDACTED]"
    },
    {
      "name": "github_fine_grained_pat",
      "pattern": "github_pat_[A-Za-z0-9_]{40,}",
      "replacement": "github_pat_[REDACTED]"
    },
    {
      "name": "bearer_token",
      "pattern": "(?i)bearer\\s+[A-Za-z0-9._-]{20,}",
      "replacement": "Bearer [REDACTED]"
    },
    {
      "name": "authorization_header",
      "pattern": "(?i)authorization:\\s*\\S+",
      "replacement": "Authorization: [REDACTED]"
    },
    {
      "name": "password_assignment",
      "pattern": "(?i)(password|passwd|pw|비밀번호)\\s*[:=]\\s*\\S+",
      "replacement": "\\1=[REDACTED]"
    },
    {
      "name": "slack_token",
      "pattern": "xox[baprs]-[A-Za-z0-9-]{10,}",
      "replacement": "xox*-[REDACTED]"
    },
    {
      "name": "korean_resident_registration_number",
      "pattern": "\\b\\d{6}-\\d{7}\\b",
      "replacement": "[REDACTED_RRN]"
    },
    {
      "name": "credit_card_like",
      "pattern": "\\b\\d{4}[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{4}\\b",
      "replacement": "[REDACTED_CARD]"
    },
    {
      "name": "aws_access_key",
      "pattern": "AKIA[0-9A-Z]{16}",
      "replacement": "AKIA[REDACTED]"
    },
    {
      "name": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "replacement": "[REDACTED_JWT]"
    },
    {
      "name": "private_key_block",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]+?-----END [A-Z ]*PRIVATE KEY-----",
      "replacement": "[REDACTED_PRIVATE_KEY]"
    }
  ]
}
